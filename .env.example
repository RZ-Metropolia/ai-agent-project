# Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Highest number of tokens in one model reply. Groq's free tier refuses more than 1000.
GROQ_MAX_TOKENS=800

# Mock inventory API
INVENTORY_API_URL=http://127.0.0.1:8000
INVENTORY_TIMEOUT_SECONDS=2

# Restaurant
# Database file. Leave empty to use data/restaurant.db.
RESTAURANT_DB_PATH=
RESTAURANT_TIMEZONE=Europe/Berlin
# Fixed service day as YYYY-MM-DD. Leave empty to use today in the restaurant's time zone.
SERVICE_DATE=
